    "qs": "^6.16.0",
    "cookiejar": "^2.1.4",
    "form-data": "^3.0.5",
    "validator": "^13.15.22",
    "terser": "^5.14.2",
    "follow-redirects": "^1.16.0",
    "node-fetch": "^2.6.7",
    "tmpl": "^1.0.5",
    "json5": "^2.2.2",
    "tough-cookie": "^4.1.3",
    "braces": "^3.0.3",
    "micromatch": "^4.0.8",
    "word-wrap": "^1.2.4",
